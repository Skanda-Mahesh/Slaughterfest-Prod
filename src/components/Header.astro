---
import { site, ticketHref, ticketAttrs } from '../lib/site';
---
<header class="top">
  <div class="top-in">
    <a class="brand" href="#top">{site.name} <b>{site.year}</b></a>
    <button class="burger" id="burger" aria-expanded="false" aria-controls="nav">Menu</button>
    <nav id="nav" aria-label="Main">
      <ul>
        <li><a href="#lineup">Lineup</a></li>
        <li><a href="#info">Info</a></li>
        <li><a href="#tickets">Tickets</a></li>
        <li><a href="#venue">Venue</a></li>
        <li><a class="cta" href={ticketHref} {...ticketAttrs}>Book tickets</a></li>
      </ul>
    </nav>
    <a class="ig" href={site.instagram} target="_blank" rel="noopener noreferrer" aria-label="Slaughter Fest on Instagram (opens in a new tab)">
      <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4.2" /><circle cx="17.4" cy="6.6" r="1" fill="currentColor" stroke="none" /></svg>
    </a>
  </div>
</header>
