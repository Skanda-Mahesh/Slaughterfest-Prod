---
import partners from '../data/partners.json';
import { asset, manifest, site } from '../lib/site';
---
<section class="partners" aria-labelledby="ph">
  <h2 id="ph" class="rv">Partners</h2>
  <ul class="pstrip">
    {partners.map((p, i) => {
      const img = p.logo ? manifest[p.logo] : null;
      return (
        <li class="rv" style={`--i:${i}`}>
          {img ? (
            p.url ? (
              <a class:list={{ chip: p.chip }} href={p.url} target="_blank" rel="noopener"><img src={asset(img.src)} width={img.width} height={img.height} alt={p.alt} loading="lazy" decoding="async" /></a>
            ) : (
              <span class:list={['logo', { chip: p.chip }]}><img src={asset(img.src)} width={img.width} height={img.height} alt={p.alt} loading="lazy" decoding="async" /></span>
            )
          ) : (
            <span class="txt">{p.name}</span>
          )}
        </li>
      );
    })}
  </ul>
  <p class="produced">Produced by {site.producedBy}</p>
</section>
